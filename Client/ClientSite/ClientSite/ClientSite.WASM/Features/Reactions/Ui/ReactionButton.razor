@using ClientSite.WASM.Features.Reactions.Api
@using ClientSite.WASM.Features.Reactions.Models

<div class="flex flex-wrap items-center gap-2">

    @foreach (var reactionGroup in GetGroupedReactions())
    {
        <div class="flex items-center">
            <button @onclick="() => ToggleReaction(reactionGroup.Type)"
                    class="@GetReactionButtonClass(reactionGroup.Type, reactionGroup.HasUserReaction)
                                       flex items-center gap-1 px-2 py-1 rounded-full transition-all hover:scale-105">
                <span class="text-lg">@ReactionTypes.GetById(reactionGroup.Type)?.Emoji</span>
                <span class="bg-opacity-50 rounded bg-white px-1 text-xs font-semibold">@reactionGroup.Count</span>
            </button>
        </div>
    }

    <button @onclick="@ToggleReactionModal"
            class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
    </button>

</div>

@if (_showReactionModal)
{
    <div @onclick="@ToggleReactionModal"
         class="fixed inset-0 z-50 flex items-center justify-center" style="background-color: rgba(0, 0, 0, 0.9)">
        <div @onclick:stopPropagation
             class="mx-4 w-full max-w-md rounded-lg bg-white p-6 shadow-xl">

            <div class="mb-4 flex items-center justify-between">

                <h3 class="text-lg font-semibold text-gray-800">Выберите реакцию</h3>

                <button @onclick="@ToggleReactionModal"
                        class="text-gray-500 hover:text-gray-700">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

            </div>

            <div class="grid grid-cols-5 gap-3">
                @foreach (var reactionType in ReactionTypes.All)
                {
                    var userHasThisReaction = Reactions.Any(r => r.Type == reactionType.Id && r.UserId == _clientSettings?.UserId);
                    var userHasAnyReaction = Reactions.Any(r => r.UserId == _clientSettings?.UserId);
                    var totalCount = Reactions.Count(r => r.Type == reactionType.Id);

                    <button @onclick="() => SelectReaction(reactionType.Id)"
                            class="@(userHasThisReaction ? "bg-blue-50 ring-2 ring-blue-200" : "hover:bg-gray-100")
                                                   flex flex-col items-center rounded-lg p-2 transition-colors">

                        <div class="mb-1 text-2xl">@reactionType.Emoji</div>

                        @if (totalCount > 0)
                        {
                            <div class="mt-1 text-xs font-medium @(userHasThisReaction ? "text-blue-700" : "text-gray-700")">
                                @totalCount
                            </div>
                        }

                    </button>
                }
            </div>

        </div>
    </div>
}