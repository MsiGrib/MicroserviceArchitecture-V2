@using ClientSite.WASM.Features.Comments.Api
@using ClientSite.WASM.Shared.Components.Buttons.Ui
@using ClientSite.WASM.Shared.Components.Inputs.Ui
@using ClientSite.WASM.Shared.Components.Texts.Lib

<div class="mt-4">

    <TextArea SimpleTextType="@SimpleTextType.H6" Placeholder="Добавить комментарий..." Rows="2"
              ValueChanged="@OnContentHandler"
              class="w-full rounded-lg border p-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-500" />

    <div class="mt-2 flex justify-end">
        <Button SimpleTextType="@SimpleTextType.Button2"
                OnClick="@OnAddCommentClick"
                class="rounded-xl bg-blue-500 px-6 py-2.5 text-white shadow-sm transition-colors duration-150 hover:bg-blue-600">
            Отправить
        </Button>
    </div>

</div>