@using ClientSite.WASM.Shared.Components.Buttons.Ui
@using ClientSite.WASM.Shared.Components.Inputs
@using ClientSite.WASM.Shared.Components.Inputs.Ui
@using ClientSite.WASM.Shared.Components.Texts.Lib
@using ClientSite.WASM.Shared.Components.Texts.Ui

<div class="mb-6 w-full rounded-lg bg-white p-6 shadow-md">

    <SimpleText Type="SimpleTextType.H4"
                class="mb-4">
        Создать новый пост
    </SimpleText>

    <div class="space-y-4">

        <div>
            <SimpleText Type="SimpleTextType.H5"
                        class="mb-1 block text-gray-700">
                Заголовок
            </SimpleText>
            
            <BaseInput SimpleTextType="@SimpleTextType.H6" Placeholder="Введите заголовок..."
                       ValueChanged="@OnTitleHandler"
                       class="w-full rounded-lg border p-2 focus:ring-2 focus:ring-blue-500" />
        </div>

        <div>
            <SimpleText Type="SimpleTextType.H5"
                        class="mb-1 block text-gray-700">
                Содержимое
            </SimpleText>

            <TextArea SimpleTextType="@SimpleTextType.H6" Placeholder="Введите содержимое поста..."
                      ValueChanged="@OnContentHandler"
                      class="w-full rounded-lg border p-2 focus:ring-2 focus:ring-blue-500" />
        </div>

        <div class="flex justify-end space-x-3">
            <Button SimpleTextType="@SimpleTextType.Button2"
                    OnClick="@OnCancelClick"
                    class="w-full rounded-xl bg-blue-600 px-6 py-2.5 text-white shadow-sm transition-colors duration-150 hover:bg-blue-700">
                Отмена
            </Button>

            <Button SimpleTextType="@SimpleTextType.Button2"
                    OnClick="@OnCreatePostClick"
                    class="w-full rounded-xl bg-blue-600 px-6 py-2.5 text-white shadow-sm transition-colors duration-150 hover:bg-blue-700">
                Опубликовать
            </Button>
        </div>

    </div>

</div>