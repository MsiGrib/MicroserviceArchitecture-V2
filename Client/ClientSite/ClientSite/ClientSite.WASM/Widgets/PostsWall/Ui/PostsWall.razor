@using ClientSite.WASM.Features.Posts.Api
@using ClientSite.WASM.Features.Comments.Api
@using ClientSite.WASM.Features.Posts.Ui
@using ClientSite.WASM.Features.Reactions.Api

<div class="mx-auto max-w-4xl">
    <div class="mb-6 flex justify-end">
        @if (IsCreatingPost)
        {
            <CreatePostForm OnPostCreated="@HandlePostCreated"
                            OnCancel="() => IsCreatingPost = false" />
        }
        else
        {
            <button @onclick="@ShowCreatePostForm"
                    class="flex items-center rounded-lg bg-green-500 px-6 py-3 text-white hover:bg-green-600">
                <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Добавить пост
            </button>
        }
    </div>

    <div class="space-y-6">
        @if (_isLoading)
        {
            <div class="py-10 text-center">
                <div class="mx-auto h-12 w-12 animate-spin rounded-full border-b-2 border-blue-500"></div>
                <p class="mt-4 text-gray-600">Загрузка постов...</p>
            </div>
        }
        else if (_posts.Any())
        {
            @foreach (var post in _posts)
            {
                <PostCard Post="@post" 
                          OnPostUpdated="@HandlePostUpdated" />
            }
        }
        else
        {
            <div class="rounded-lg bg-gray-50 py-10 text-center">
                <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <p class="mt-4 text-gray-600">Пока нет постов. Будьте первым!</p>
            </div>
        }
    </div>
</div>