@using ClientSite.WASM.Features.Posts.Api
@using ClientSite.WASM.Features.Comments.Api
@using ClientSite.WASM.Features.Posts.Ui
@using ClientSite.WASM.Features.Reactions.Api
@using ClientSite.WASM.Shared.Components.Buttons.Ui
@using ClientSite.WASM.Shared.Components.Loaders.Lib
@using ClientSite.WASM.Shared.Components.Loaders.Ui
@using ClientSite.WASM.Shared.Components.Texts.Lib
@using ClientSite.WASM.Shared.Components.Texts.Ui

<div class="mx-auto max-w-4xl">

    <div class="my-6 flex w-full justify-center">
        @if (_isCreatingPost)
        {
            <CreatePostForm OnPostCreated="@HandlePostCreated"
                            OnCancel="() => _isCreatingPost = false" />
        }
        else
        {
            <Button SimpleTextType="@SimpleTextType.Button2"
                    OnClick="@ShowCreatePostForm"
                    class="w-full rounded-xl bg-blue-600 px-6 py-2.5 text-white shadow-sm transition-colors duration-150 hover:bg-blue-700">
                Добавить пост
            </Button>
        }
    </div>

    <div class="space-y-6">
        @if (_isLoading)
        {
            <Loader Type="LoaderType.Spinner" Size="LoaderSize.ExtraLarge"
                    Color="border-blue-600"
                    BackgroundColor="text-gray-100" />
        }
        else if (_posts.Any())
        {
            @foreach (var post in _posts)
            {
                <PostCard Post="@post" 
                          OnPostUpdated="@HandlePostUpdated" />
            }
        }
        else
        {
            <div class="rounded-lg bg-gray-50 py-10 text-center">

                <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>

                <SimpleText Type="SimpleTextType.H4"
                            class="mt-4 text-gray-600">
                    Пока нет постов. Будьте первым!
                </SimpleText>

            </div>
        }
    </div>

</div>